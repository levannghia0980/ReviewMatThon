# ==============================================================================
# REVIEW MAT THON - CẤU HÌNH HỆ THỐNG GỐC (.env.example)
# Toàn bộ thông số kỹ thuật chuẩn hóa để mọi máy clone về chạy trơn tru 100%.
# Các khóa API cá nhân hãy điền tương ứng nếu dùng provider đó.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CHẾ ĐỘ MÁY CHỦ PHÁT TRIỂN
# ------------------------------------------------------------------------------
# Chỉ máy chủ dev đặt true để tự động push code. Máy người dùng/client luôn là false.
IS_SERVER_HOST=false

# ------------------------------------------------------------------------------
# 2. AI SPEECH-TO-TEXT (STT / ASR)
# ------------------------------------------------------------------------------
# Engine ASR: "capcut" (SAMI ByteDance tốc độ cao, miễn phí) | "groq" (Cloud) | "faster_whisper" (Offline)
ASR_ENGINE=capcut
# Số luồng nhận diện giọng nói song song
ASR_MAX_WORKERS=10
# Độ trễ thời gian STT (mili-giây) trừ về trước để khớp chuẩn khẩu hình/thoại gốc
STT_TIME_OFFSET_MS=30

# Cấu hình Groq Whisper Cloud (nếu dùng ASR_ENGINE=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3

# Cấu hình Faster-Whisper Offline (nếu dùng ASR_ENGINE=faster_whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------------------------
# 3. DỊCH THUẬT & TRÍ TUỆ NHÂN TẠO (TRANSLATION / LLM)
# ------------------------------------------------------------------------------
# Nhà cung cấp dịch thuật: "gemini" (Web/API) | "openrouter"
TRANSLATION_PROVIDER=gemini
TRANSLATION_BATCH_SIZE=500
TRANSLATION_MAX_CHARS=50000
TRANSLATION_TEMPERATURE=0.25

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_BUDGET=-1

# Gemini Web Automation (Playwright On-Demand)
GEMINI_WEB_MODEL=flash
GEMINI_WEB_THINKING=medium
GEMINI_WEB_HEADLESS=false

# OpenRouter API (Fallback hoặc chạy đa mô hình)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. TEXT-TO-SPEECH (TTS - LỒNG TIẾNG)
# ------------------------------------------------------------------------------
# Engine TTS: "capcut" (CapCut Cloud SAMI chất lượng cao) | "tiktok"
TTS_ENGINE=capcut
# Số luồng sinh âm thanh song song (mặc định 96 luồng ưu tiên cao)
TTS_MAX_WORKERS=96
# Session TikTok chuẩn mặc định của hệ thống
TIKTOK_SESSION_ID=410bfa37bdc185e1c6da82e1afb48409
# Cookie CapCut riêng nếu có (để trống hệ thống tự dùng token tiêu chuẩn)
CAPCUT_COOKIE=
# Cờ gộp câu TTS (False: mỗi câu thoại giữ nguyên mốc thời gian độc lập)
TTS_MERGE_CHUNKS=False

# ------------------------------------------------------------------------------
# 5. RENDER VIDEO THÍCH ỨNG PHẦN CỨNG & PHÂN ĐOẠN SONG SONG
# ------------------------------------------------------------------------------
# Số luồng render video phân đoạn song song (tự động thích ứng GPU/CPU)
VIDEO_RENDER_WORKERS=3
# Thời lượng mỗi phân đoạn video (giây) khi chia nhỏ render song song
VIDEO_SEGMENT_DURATION=300
# Ngưỡng kích hoạt chia nhỏ video (giây)
VIDEO_SINGLE_CHUNK_LIMIT=1200

# ------------------------------------------------------------------------------
# 6. TẢI VIDEO & DỮ LIỆU ĐẦU VÀO
# ------------------------------------------------------------------------------
# File cookie Bilibili để tải video chất lượng 1080p 60fps
BILIBILI_COOKIE_FILE=cookies.txt
