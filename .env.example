# ==============================================================================
# REVIEW MAT THON - CẤU HÌNH MẪU (.env.example)
# ==============================================================================

# Chế độ máy chủ phát triển (Chỉ máy chủ bật true để tự động đẩy code lên GitHub, máy người dùng luôn là false)
IS_SERVER_HOST=false

# AI Speech-to-Text
ASR_ENGINE=capcut
# Số luồng nhận diện giọng nói song song (mặc định 8, máy yếu có thể chỉnh 4-6)
ASR_MAX_WORKERS=8
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3

# Faster-Whisper Offline
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Cấu hình dịch thuật lô lớn (AIRead)
TRANSLATION_BATCH_SIZE=500
TRANSLATION_MAX_CHARS=50000

# ==============================================================================
# TTS (Text-to-Speech) - TikTok / CapCut
# ==============================================================================

# Engine TTS: "capcut" (khuyến dùng) hoặc "tiktok"
TTS_ENGINE=capcut

# Số luồng song song xử lý TTS (64-96 cho máy mạnh, 16-32 cho máy yếu)
# Không cần sửa trong code, chỉ sửa ở đây
TTS_MAX_WORKERS=96

# Cookie CapCut (lấy từ trình duyệt sau khi đăng nhập capcut.com)
# Format: sessionid=abc123... hoặc chỉ điền mã phía sau sessionid=
CAPCUT_COOKIE=your_capcut_cookie_here

# Session ID TikTok (dùng cho engine "tiktok", hoặc fallback cho CapCut nếu CAPCUT_COOKIE chưa set)
TIKTOK_SESSION_ID=your_tiktok_session_id_here

# Đường dẫn file proxy (mỗi dòng 1 proxy: http://user:pass@ip:port)
# Để trống nếu không dùng proxy
# PROXY_FILE=proxies.txt
