# ==============================================================================
# REVIEW MAT THON - CẤU HÌNH HỆ THỐNG GỐC (.env.example)
# Toàn bộ thông số kỹ thuật chuẩn hóa để mọi máy clone về chạy đồng nhất 100%.
# Các khóa API cá nhân hãy điền tương ứng nếu dùng provider đó.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CHẾ ĐỘ MÁY CHỦ PHÁT TRIỂN
# ------------------------------------------------------------------------------
# Chỉ máy chủ dev đặt true. Máy người dùng/client luôn là false.
IS_SERVER_HOST=false

# ------------------------------------------------------------------------------
# 2. AI SPEECH-TO-TEXT (STT / ASR) & TINH CHỈNH PHỤ ĐỀ ẢNH (VISUAL OCR)
# ------------------------------------------------------------------------------
# Engine ASR: "capcut" (SAMI ByteDance tốc độ cao, miễn phí) | "groq" (Cloud) | "faster_whisper" (Offline)
ASR_ENGINE=capcut
# Số luồng nhận diện giọng nói song song (Máy nhiều nhân CPU khuyến nghị 8-12 luồng)
ASR_MAX_WORKERS=10
# Độ trễ thời gian STT (mili-giây) trừ về trước để khớp chuẩn khẩu hình/thoại gốc
STT_TIME_OFFSET_MS=30

# Cấu hình Groq Whisper Cloud (nếu dùng ASR_ENGINE=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3

# Cấu hình Faster-Whisper Offline (nếu dùng ASR_ENGINE=faster_whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Tinh chỉnh phụ đề cứng trên video bằng OCR offline (RapidOCR PP-OCRv4/v5)
# - False (Mặc định): Tắt để tối ưu tốc độ bóc tách ASR
# - True: Bật quét phụ đề cứng nhằm gộp câu & sửa lỗi đồng âm CapCut
ENABLE_VISUAL_SUB_REFINER=False
# Số luồng quét OCR song song (0 = Tự thích ứng GPU/VRAM/RAM/CPU qua hardware_profile)
OCR_WORKERS=0
# Thời lượng mỗi micro-chunk khi quét OCR tính bằng giây (0 = Tự động theo độ dài video)
OCR_CHUNK_SECONDS=0
# Bộ giải mã phần cứng FFmpeg cho OCR: "auto" | "cuda" | "qsv" | "d3d11va" | "cpu"
OCR_HWACCEL=auto

# ------------------------------------------------------------------------------
# 3. DỊCH THUẬT & TRÍ TUỆ NHÂN TẠO (TRANSLATION / LLM)
# ------------------------------------------------------------------------------
# Nhà cung cấp dịch thuật: "gemini" (API) | "gemini_web" (Browser) | "openrouter"
TRANSLATION_PROVIDER=gemini
# Thể loại mặc định khi không chỉ định: "tienhiep" | "wuxia" | "urban" | "urban_supernatural" | "romance" | "system_reincarnation" | "sci_fi_apocalypse"
TRANSLATION_GENRE=tienhiep
TRANSLATION_BATCH_SIZE=500
TRANSLATION_MAX_CHARS=50000
TRANSLATION_TEMPERATURE=0.25

# Gemini API (Gateway BE tự động khóa Temp=0.25, TopP=0.95, TopK=40, Thinking 8192 cho 3.1 / Dynamic -1 cho 3.5)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_BUDGET=8192
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40
GEMINI_REQUEST_TIMEOUT=300.0
# Giãn cách tối thiểu (giây) giữa các request Gemini API để tránh chạm mốc 15 RPM Free Tier
GEMINI_PACING_INTERVAL=4.1

# Gemini Web Automation (Playwright On-Demand)
GEMINI_WEB_MODEL=flash
# Mức tư duy Gemini Web: "low" | "medium" | "high"
GEMINI_WEB_THINKING=low
GEMINI_WEB_HEADLESS=false

# OpenRouter API (Fallback hoặc chạy đa mô hình)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Grok Web Local Server (Tùy chọn, chỉ dùng khi TRANSLATION_PROVIDER=grok_local)
# AIREAD_GROK_URL=http://127.0.0.1:8020/translate-text

# ------------------------------------------------------------------------------
# 4. TEXT-TO-SPEECH (TTS - LỒNG TIẾNG)
# ------------------------------------------------------------------------------
# Engine TTS: "capcut" (CapCut Cloud SAMI chất lượng cao) | "tiktok"
TTS_ENGINE=capcut
# Số luồng sinh âm thanh song song (mặc định 128 luồng ưu tiên cao cho mạng mạnh)
TTS_MAX_WORKERS=128
# Session TikTok chuẩn mặc định của hệ thống
TIKTOK_SESSION_ID=410bfa37bdc185e1c6da82e1afb48409
# Cookie CapCut riêng nếu có (để trống hệ thống tự dùng token tiêu chuẩn)
CAPCUT_COOKIE=
# Cờ gộp câu TTS (False: mỗi câu thoại giữ nguyên mốc thời gian độc lập)
TTS_MERGE_CHUNKS=False
# Danh sách Proxy xoay vòng cho TTS (tùy chọn, cách nhau bằng dấu phẩy hoặc chấm phẩy)
PROXY_LIST=

# ------------------------------------------------------------------------------
# 5. RENDER VIDEO THÍCH ỨNG PHẦN CỨNG & PHÂN ĐOẠN SONG SONG
# ------------------------------------------------------------------------------
# Số luồng render video phân đoạn song song:
# - Mặc định 0: Hệ thống tự động nhận diện phần cứng GPU/CPU để phân bổ luồng tối ưu
# - RTX 3050 (4GB-6GB VRAM): Khuyến nghị 3 hoặc 4 luồng
# - RTX 4060 / 4070 / 4080 / 4090 (8GB-16GB+ VRAM): Khuyến nghị 4 đến 6 luồng
# - Intel QuickSync (iGPU QSV): Khuyến nghị 3 đến 4 luồng
# - Máy thuần CPU (không GPU rời): Tự động dùng (cpu_cores - 1) luồng
VIDEO_RENDER_WORKERS=0
# Thời lượng mỗi phân đoạn video (giây) khi chia nhỏ render song song
VIDEO_SEGMENT_DURATION=300
# Ngưỡng kích hoạt chia nhỏ video (giây) - video trên 20 phút tự động cắt phân đoạn render song song
VIDEO_SINGLE_CHUNK_LIMIT=1200

# ------------------------------------------------------------------------------
# 6. TẢI VIDEO & DỮ LIỆU ĐẦU VÀO
# ------------------------------------------------------------------------------
# File cookie Bilibili để tải video chất lượng 1080p 60fps
BILIBILI_COOKIE_FILE=cookies.txt
